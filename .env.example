# Server
PORT=3000
DATA_PATH=./data
DATABASE_PATH=./data/rendering.sqlite

# Provider: openai for the real adapter, mock for local UI/integration checks
IMAGE_PROVIDER=openai
IMAGE_PROVIDER_MODEL=gpt-image-2.5-sunburst
DEMO_OUTPUT_PATH=./demo-assets/demo-residential.svg
OPENAI_API_KEY=
API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Safety limits
MAX_UPLOAD_BYTES=10485760
PROVIDER_TIMEOUT_MS=120000
